@page
@model NewExpenseModel
@{
    ViewData["Title"] = "New Expense";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Add New Expense</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="Amount" class="form-label">Amount (£)</label>
                        <input type="number" step="0.01" class="form-control" id="Amount" name="Expense.Amount" 
                               value="@Model.Expense.Amount" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="ExpenseDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="ExpenseDate" name="Expense.ExpenseDate" 
                               value="@Model.Expense.ExpenseDate.ToString("yyyy-MM-dd")" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="CategoryId" class="form-label">Category</label>
                        <select class="form-select" id="CategoryId" name="Expense.CategoryId" required>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(Model.Expense.CategoryId == category.CategoryId)">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Expense.Description" 
                                  rows="3">@Model.Expense.Description</textarea>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create Expense</button>
                        <a asp-page="/Expenses" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
