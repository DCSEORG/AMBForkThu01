@page
@model ExpenseManagement.Pages.ApproveModel
@{
    ViewData["Title"] = "Approve Expenses";
    if (Model.Error != null)
    {
        ViewData["Error"] = Model.Error;
    }
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-6 fw-bold">
            <i class="fas fa-check-circle me-2"></i>Approve Expenses
        </h1>
        <p class="text-muted">Review and approve pending expense claims</p>
    </div>
</div>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Filter:</label>
                <input type="text" name="search" class="form-control" placeholder="Search..." value="@Model.SearchTerm">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-page="/Approve" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Pending Expenses Header -->
<div class="alert alert-info mb-4">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Pending Expenses:</strong> @Model.PendingExpenses.Count() expense(s) awaiting your approval
</div>

<!-- Pending Expenses Table -->
<div class="card">
    <div class="card-header">
        <i class="fas fa-clock me-2"></i>Pending Approval
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Submitted By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.PendingExpenses)
                    {
                        <tr>
                            <td>@expense.FormattedDate</td>
                            <td>@expense.CategoryName</td>
                            <td>@(expense.Description ?? "-")</td>
                            <td><strong>@expense.FormattedAmount</strong></td>
                            <td>@expense.UserName</td>
                            <td>
                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                    <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                        <i class="fas fa-check me-1"></i>Approve
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" class="d-inline" onsubmit="return confirm('Are you sure you want to reject this expense?');">
                                    <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                        <i class="fas fa-times me-1"></i>Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.PendingExpenses.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-check-circle fa-2x mb-2" style="color: #48bb78;"></i>
                                <p class="mb-0">No expenses pending approval. All caught up!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
