<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Expense Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary-color: #2c5282;
            --secondary-color: #4299e1;
            --success-color: #48bb78;
            --warning-color: #ecc94b;
            --danger-color: #f56565;
            --bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f7fafc;
            min-height: 100vh;
        }
        
        .navbar {
            background: var(--bg-gradient) !important;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: 500;
        }
        
        .nav-link:hover {
            opacity: 0.9;
        }
        
        .error-banner {
            background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
            color: white;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .error-banner h5 {
            margin-bottom: 0.5rem;
        }
        
        .error-banner .error-details {
            font-size: 0.875rem;
            opacity: 0.9;
        }
        
        .error-banner .error-fix {
            background: rgba(255, 255, 255, 0.1);
            padding: 0.75rem;
            border-radius: 0.375rem;
            margin-top: 0.75rem;
            font-family: monospace;
            font-size: 0.8rem;
            white-space: pre-wrap;
        }
        
        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
        }
        
        .card-header {
            background: var(--bg-gradient);
            color: white;
            border-radius: 1rem 1rem 0 0 !important;
            padding: 1rem 1.5rem;
        }
        
        .btn-primary {
            background: var(--bg-gradient);
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        
        .table {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .table thead {
            background: var(--primary-color);
            color: white;
        }
        
        .table thead th {
            border: none;
            padding: 1rem;
            font-weight: 500;
        }
        
        .table tbody tr:hover {
            background: rgba(66, 153, 225, 0.1);
        }
        
        .badge-status {
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            font-weight: 500;
            font-size: 0.75rem;
        }
        
        .badge-draft { background: #e2e8f0; color: #4a5568; }
        .badge-submitted { background: #bee3f8; color: #2b6cb0; }
        .badge-approved { background: #c6f6d5; color: #276749; }
        .badge-rejected { background: #fed7d7; color: #c53030; }
        
        .form-control, .form-select {
            border-radius: 0.5rem;
            border: 2px solid #e2e8f0;
            padding: 0.75rem 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
        }
        
        .chat-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 1000;
        }
        
        .chat-button {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--bg-gradient);
            border: none;
            color: white;
            font-size: 1.5rem;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .chat-button:hover {
            transform: scale(1.1);
        }
        
        .chat-window {
            display: none;
            position: fixed;
            bottom: 6rem;
            right: 2rem;
            width: 400px;
            height: 500px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            flex-direction: column;
            overflow: hidden;
        }
        
        .chat-window.open {
            display: flex;
        }
        
        .chat-header {
            background: var(--bg-gradient);
            color: white;
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            background: #f7fafc;
        }
        
        .chat-message {
            margin-bottom: 1rem;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            max-width: 85%;
        }
        
        .chat-message.user {
            background: var(--bg-gradient);
            color: white;
            margin-left: auto;
        }
        
        .chat-message.assistant {
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .chat-input-container {
            padding: 1rem;
            background: white;
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 0.5rem;
        }
        
        .chat-input {
            flex: 1;
            border: 2px solid #e2e8f0;
            border-radius: 2rem;
            padding: 0.5rem 1rem;
            outline: none;
        }
        
        .chat-input:focus {
            border-color: var(--secondary-color);
        }
        
        .chat-send {
            background: var(--bg-gradient);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            color: white;
            cursor: pointer;
        }
        
        footer {
            background: #2d3748;
            color: #a0aec0;
            padding: 1rem 0;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="fas fa-receipt me-2"></i>Expense Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index"><i class="fas fa-home me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Expenses"><i class="fas fa-list me-1"></i> Expenses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/AddExpense"><i class="fas fa-plus-circle me-1"></i> Add Expense</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Approve"><i class="fas fa-check-circle me-1"></i> Approve</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger"><i class="fas fa-code me-1"></i> API Docs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container py-4">
        @if (ViewData["Error"] is ExpenseManagement.Models.AppError error)
        {
            <div class="error-banner">
                <h5><i class="fas fa-exclamation-triangle me-2"></i>Error Connecting to Database</h5>
                <div class="error-details">
                    <strong>@error.Message</strong>
                    @if (!string.IsNullOrEmpty(error.FileName))
                    {
                        <br /><span>File: @error.FileName, Line: @error.LineNumber</span>
                    }
                    @if (!string.IsNullOrEmpty(error.Details))
                    {
                        <br /><span>@error.Details</span>
                    }
                </div>
                @if (error.IsManagedIdentityError)
                {
                    <div class="error-fix">@error.ManagedIdentityFix</div>
                }
                <p class="mt-2 mb-0"><em>Displaying demo data below. Connect to the database to see real data.</em></p>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Chat UI -->
    <div class="chat-container">
        <button class="chat-button" onclick="toggleChat()" title="AI Assistant">
            <i class="fas fa-comments"></i>
        </button>
        <div class="chat-window" id="chatWindow">
            <div class="chat-header">
                <span><i class="fas fa-robot me-2"></i>AI Assistant</span>
                <button class="btn-close btn-close-white" onclick="toggleChat()"></button>
            </div>
            <div class="chat-messages" id="chatMessages">
                <div class="chat-message assistant">
                    Hello! I'm your AI assistant for the Expense Management System. How can I help you today?
                </div>
            </div>
            <div class="chat-input-container">
                <input type="text" class="chat-input" id="chatInput" placeholder="Type a message..." onkeypress="handleChatKeyPress(event)">
                <button class="chat-send" onclick="sendChatMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <footer class="border-top text-muted">
        <div class="container text-center">
            &copy; 2025 - Expense Management System - <a asp-area="" asp-page="/Privacy" class="text-light">Privacy</a>
            <span class="ms-3"><small>App URL: /Index</small></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleChat() {
            const chatWindow = document.getElementById('chatWindow');
            chatWindow.classList.toggle('open');
            if (chatWindow.classList.contains('open')) {
                document.getElementById('chatInput').focus();
            }
        }
        
        function handleChatKeyPress(event) {
            if (event.key === 'Enter') {
                sendChatMessage();
            }
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        function formatMessage(text) {
            // Escape HTML first
            let formatted = escapeHtml(text);
            
            // Apply markdown-style formatting
            formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            formatted = formatted.replace(/```([\s\S]*?)```/g, '<pre style="background:#f1f5f9;padding:0.5rem;border-radius:0.25rem;overflow-x:auto">$1</pre>');
            formatted = formatted.replace(/`([^`]+)`/g, '<code style="background:#f1f5f9;padding:0.125rem 0.25rem;border-radius:0.25rem">$1</code>');
            
            // Handle numbered lists
            const lines = formatted.split('\n');
            let inList = false;
            let result = [];
            
            for (let line of lines) {
                if (/^\d+\.\s/.test(line)) {
                    if (!inList) {
                        result.push('<ol style="margin:0.5rem 0;padding-left:1.5rem">');
                        inList = true;
                    }
                    result.push('<li>' + line.replace(/^\d+\.\s/, '') + '</li>');
                } else if (/^[-*]\s/.test(line)) {
                    if (!inList) {
                        result.push('<ul style="margin:0.5rem 0;padding-left:1.5rem">');
                        inList = true;
                    }
                    result.push('<li>' + line.replace(/^[-*]\s/, '') + '</li>');
                } else {
                    if (inList) {
                        result.push('</ol>');
                        inList = false;
                    }
                    result.push(line);
                }
            }
            if (inList) result.push('</ol>');
            
            formatted = result.join('\n').replace(/\n/g, '<br>');
            return formatted;
        }
        
        async function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;
            
            const messagesContainer = document.getElementById('chatMessages');
            
            // Add user message
            const userDiv = document.createElement('div');
            userDiv.className = 'chat-message user';
            userDiv.textContent = message;
            messagesContainer.appendChild(userDiv);
            
            input.value = '';
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            // Add loading indicator
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'chat-message assistant';
            loadingDiv.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Thinking...';
            messagesContainer.appendChild(loadingDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                
                const data = await response.json();
                
                loadingDiv.innerHTML = formatMessage(data.response);
                
                if (!data.isConfigured) {
                    loadingDiv.innerHTML += '<br><small class="text-muted"><em>Running in demo mode</em></small>';
                }
            } catch (error) {
                loadingDiv.innerHTML = '<span class="text-danger">Sorry, an error occurred. Please try again.</span>';
            }
            
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>